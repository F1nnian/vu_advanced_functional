cabal-version:      3.14
name:               AFP

version:            0.1.0.0

author:             René Thiemann

category:           Development
build-type:         Simple

common warnings
    ghc-options: 
      -O2 
      -Wall 
      -Wno-incomplete-patterns 
      -Wno-incomplete-uni-patterns 
      -Wno-unused-matches
      -Wno-unused-top-binds
      -Wno-missing-signatures
      -Wno-name-shadowing

executable Demo06
    
    main-is: Main.hs

    other-modules: 
      Demo06_Emb
      , Demo06_Tseitin_Monad_RWS
      , Demo06_NestedLookup
      , Exercise06_Tseitin
      , Exercise06_Emb
      
    default-extensions:
      ExplicitForAll, 
      RankNTypes,
      ScopedTypeVariables,
      FlexibleContexts

    build-depends:    base >=4.19
       , bytestring
       , containers
       , mtl  
       , random
       , timeit

    hs-source-dirs:   src

    default-language: Haskell2010
