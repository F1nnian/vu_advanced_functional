; @author Alwin Schüßler
; secret problem 2026
; category: TRS

(format TRS)
(fun F 2)
(fun f 2)
(fun g 1)
(fun h 1)

(rule (f x y) x)
(rule (f x y) (f x (g y)))
(rule (g x) (h x))
(rule (F (g x) x) (F x (g x)))
(rule (F (h x) x) (F x (h x)))
(rule (f (g x) y) (g x))
(rule (F (f (g x) y) y) (F (h x) y))
