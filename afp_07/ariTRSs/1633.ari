; @author René Thiemann
; secret problem 2026
; category: TRS
; union of ARI #47 and #101 with additional rules
;   R(f(f(x,y),z)) -> R(f(f(x,z),y))
;   P(x) -> P(f(x,x))
;   f(R(x),y) -> f(R(y),x)
; over shared signature 
(format TRS)
(fun f 2)
(fun F 2)
(fun G 2)
(fun H 1)
(fun K 2)
(fun P 1)
(fun Q 2)
(fun R 1)
(rule (H (F x y)) (F (H (R x)) y))
(rule (F x (K y z)) (G (P y) (Q z x)))
(rule (H (Q x y)) (Q x (H (R y))))
(rule (Q x (H (R y))) (H (Q x y)))
(rule (H (G x y)) (G x (H y)))
(rule (f (f x y) z) (f x (f y z)))
(rule (f x y) (f y x))
(rule (R (f (f x y) z)) (R (f (f x z) y)))
(rule (P x) (P (f x x)))
(rule (f (R x) y) (f (R y) x))
