cabal-version:      3.14
name:               AFP

version:            0.1.0.0

author:             René Thiemann

category:           Development
build-type:         Simple

common warnings
    ghc-options: 
      -O2 
      -Wall 
      -Wno-incomplete-patterns 
      -Wno-incomplete-uni-patterns 
      -Wno-unused-matches
      -Wno-unused-top-binds
      -Wno-missing-signatures
      -Wno-name-shadowing

executable Demo05
    import:           warnings

    main-is:          Main.hs

    other-modules:
      State
      
    default-extensions:
      ExplicitForAll, 
      RankNTypes,
      ScopedTypeVariables,
      FlexibleContexts,
      QuantifiedConstraints      

    build-depends:    base >=4.19
       , bytestring     
       , containers
       , mtl  
       , random
       , timeit
       , array
       , leancheck

    hs-source-dirs:   src

    default-language: Haskell2010
